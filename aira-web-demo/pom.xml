<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.immregistries</groupId>
    <artifactId>aira-web</artifactId>
    <version>0.1.10</version>
  </parent>

  <artifactId>aira-web-demo</artifactId>
  <packaging>war</packaging>

  <name>AIRA Web Demo</name>
  <description>Servlet-only demonstration application consuming the AIRA theme resource JAR.</description>

  <dependencies>
    <dependency>
      <groupId>org.immregistries</groupId>
      <artifactId>aira-web-components</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>aira-web-demo</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.eclipse.jetty.ee10</groupId>
        <artifactId>jetty-ee10-maven-plugin</artifactId>
        <configuration>
          <webApp>
            <contextPath>/aira-web-demo</contextPath>
          </webApp>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
